#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Aurora dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `aurora` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-aurora-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `aurora pm
# install` and `aurora update` keep that check.
# ============================================================================
_AURORA_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_aurora_test_env="--test-environment"
_aurora_expect_extras=""
for _aurora_arg in "$@"; do
    if [ -n "$_aurora_expect_extras" ]; then
        _aurora_test_env="--test-environment=$_aurora_arg"
        _aurora_expect_extras=""
        continue
    fi
    case "$_aurora_arg" in
        --) break ;;
        --test-extras) _aurora_expect_extras=1 ;;
        --test-extras=*) _aurora_test_env="--test-environment=${_aurora_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_aurora_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _aurora_arg _aurora_test_env _aurora_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _aurora_arg _aurora_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_AURORA_REPO/scripts/_activation.sh"

if ! aurora_sync "$_AURORA_REPO" "$_aurora_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _aurora_test_env
    return 1 2>/dev/null || exit 1
fi
unset _aurora_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __AURORA_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_aurora_script="$(aurora_compose_env "$_AURORA_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _aurora_script
    return 1 2>/dev/null || exit 1
}
_aurora_keys="$(printf '%s\n' "$_aurora_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __AURORA_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__AURORA_SAVED_PATH="$PATH"
for _aurora_k in $_aurora_keys; do
    eval "__AURORA_SAVED_$_aurora_k=\"\${$_aurora_k+set}\""
    eval "__AURORA_PRIOR_$_aurora_k=\${$_aurora_k-__AURORA_UNSET__}"
done
aurora_apply_env "$_aurora_script"

# This checkout, not whichever `aurora` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__AURORA_WORKTREE="$_AURORA_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__AURORA_WORKTREE_NAME="$(git -C "$_AURORA_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__AURORA_WORKTREE_NAME" ] || [ "$__AURORA_WORKTREE_NAME" = HEAD ]; then
    __AURORA_WORKTREE_NAME="$(basename "$_AURORA_REPO")"
fi
__AURORA_SAVED_PS1="${PS1-__AURORA_UNSET__}"
__AURORA_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__AURORA_UNSET__}"

_aurora_worktree_here() {
    _aurora_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_aurora_top" && pwd -P)" = "$(cd "$__AURORA_WORKTREE" && pwd -P)" ]
}

aurora() {
    _aurora_worktree_here || {
        printf '%s\n' "aurora: $(pwd) is outside $__AURORA_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__AURORA_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" aurora "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe aurora "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python aurora "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe aurora "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python aurora "$@"
        else
            exec python aurora "$@"
        fi
    )
}

_aurora_prompt() {
    if [ "$__AURORA_SAVED_PS1" = "__AURORA_UNSET__" ]; then
        _aurora_base_ps1=""
    else
        _aurora_base_ps1="$__AURORA_SAVED_PS1"
    fi
    if _aurora_worktree_here; then
        PS1="($__AURORA_WORKTREE_NAME) $_aurora_base_ps1"
    else
        PS1="$_aurora_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_aurora_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_aurora_prompt
fi
_aurora_prompt

deactivate() {
    export PATH="$__AURORA_SAVED_PATH"
    for _aurora_k in $__AURORA_KEY_LIST; do
        eval "_aurora_was=\"\$__AURORA_SAVED_$_aurora_k\""
        eval "_aurora_old=\"\$__AURORA_PRIOR_$_aurora_k\""
        if [ "$_aurora_was" != "set" ]; then
            unset "$_aurora_k"
        else
            export "$_aurora_k=$_aurora_old"
        fi
        unset "__AURORA_SAVED_$_aurora_k" "__AURORA_PRIOR_$_aurora_k"
    done
    if [ "$__AURORA_SAVED_PS1" = "__AURORA_UNSET__" ]; then
        unset PS1
    else
        PS1="$__AURORA_SAVED_PS1"
    fi
    if [ "$__AURORA_SAVED_PROMPT_COMMAND" = "__AURORA_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__AURORA_SAVED_PROMPT_COMMAND"
    fi
    unset __AURORA_SAVED_PATH __AURORA_KEY_LIST __AURORA_ACTIVATED \
          __AURORA_WORKTREE __AURORA_WORKTREE_NAME \
          __AURORA_SAVED_PS1 __AURORA_SAVED_PROMPT_COMMAND
    unset -f deactivate aurora _aurora_worktree_here _aurora_prompt
    unset _aurora_k _aurora_was _aurora_old _aurora_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__AURORA_KEY_LIST="$_aurora_keys"

# The composition library is not part of the user's shell.
unset -f aurora_sync aurora_bootstrap_python aurora_compose_env aurora_apply_env \
         aurora_activation_current aurora_ensure_env
unset _AURORA_REPO _aurora_script _aurora_keys _aurora_k _aurora_top
