#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/aurora-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as AURORA_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else AURORA_PYTHON may
# be inherited from a wrapped `aurora` (a release venv without the dev tools),
# so scripts/run-in-aurora-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__AURORA_ACTIVATED:-}" ] && [ -n "${AURORA_PYTHON:-}" ] \
    && [ -x "$AURORA_PYTHON" ]; then
    exec "$AURORA_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-aurora-env" python "$@"
